# ==============================================================================
# mesh — Go Daemon Environment Variables
# ==============================================================================
# These are the environment variables the Go daemon reads via os.Getenv().
# Primary configuration is via ~/.mesh/config.yaml (JSON/YAML).
# See mesh/CONTEXT.md for full configuration documentation.
# ==============================================================================

# Override the default config file path
# Default: ~/.mesh/config.yaml
MESH_CONFIG=/path/to/config.yaml

# Skip plugin directory validation (for test environments only)
# MESH_TESTING=true
